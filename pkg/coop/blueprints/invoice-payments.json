{
  "id": "invoice-payments",
  "title": "Invoice payment with hosted page",
  "description": "Learn how to create and collect payment on an invoice using a hosted payment page.",
  "type": "learning",
  "products": [
    "Billing"
  ],
  "settings": null,
  "steps": [
    {
      "key": "set-up-chapter",
      "title": "Set up test environment",
      "required": true,
      "nodes": [
        {
          "type": "testHelper",
          "key": "create-test-clock",
          "title": "Create a test clock",
          "description": "Run this test helper to create a test clock to control time in your test environment.",
          "requests": [
            {
              "key": "create-test-clock-request",
              "path": "/v1/test_helpers/test_clocks",
              "method": "post"
            }
          ]
        },
        {
          "type": "apiRequest",
          "key": "create-product",
          "title": "Create a product with a price",
          "description": "Create a product with a default price that will be used for the invoice.",
          "request": {
            "path": "/v1/products",
            "method": "post",
            "params": {
              "default_price_data": {
                "currency": "usd",
                "unit_amount": 10000
              },
              "name": "Example Services"
            }
          }
        },
        {
          "type": "apiRequest",
          "key": "create-customer",
          "title": "Create a customer",
          "description": "Create a customer who will receive the invoice. For testing purposes, the customer's email will be your email.",
          "request": {
            "path": "/v1/customers",
            "method": "post",
            "params": {
              "description": "Customer to Invoice",
              "email": "${env:userEmail}",
              "test_clock": "${node.set-up-chapter.create-test-clock.create-test-clock-request:id}"
            }
          }
        }
      ]
    },
    {
      "key": "create-invoice-chapter",
      "title": "Create and send the invoice",
      "nodes": [
        {
          "type": "apiRequest",
          "key": "create-invoice",
          "title": "Create an invoice",
          "description": "Create an invoice for the customer with a 30-day payment term.",
          "request": {
            "path": "/v1/invoices",
            "method": "post",
            "params": {
              "collection_method": "send_invoice",
              "customer": "${node.set-up-chapter.create-customer:id}",
              "days_until_due": 30
            }
          }
        },
        {
          "type": "apiRequest",
          "key": "add-invoice-item",
          "title": "Add an invoice item",
          "description": "Add a line item to the invoice using the product price created earlier.",
          "request": {
            "path": "/v1/invoiceitems",
            "method": "post",
            "params": {
              "customer": "${node.set-up-chapter.create-customer:id}",
              "invoice": "${node.create-invoice-chapter.create-invoice:id}",
              "pricing": {
                "price": "${node.set-up-chapter.create-product:default_price}"
              }
            }
          }
        },
        {
          "type": "apiRequest",
          "key": "send-invoice",
          "title": "Send the invoice",
          "description": "Send the invoice to the customer via email.",
          "request": {
            "path": "/v1/invoices/${node.create-invoice-chapter.create-invoice:id}/send",
            "method": "post",
            "params": {}
          }
        }
      ]
    },
    {
      "key": "payment-chapter",
      "title": "Process invoice payment",
      "nodes": [
        {
          "type": "uiComponent",
          "key": "view-invoice",
          "title": "View and pay the invoice",
          "description": "Preview the hosted invoice page where customers can view and pay their invoice online. Optionally fill out the form with the card number as 4242 4242 4242 4242. Use a valid future date, such as 12/34, and any three-digit CVC."
        },
        {
          "type": "asyncHandler",
          "key": "wait-for-invoice-paid",
          "title": "Handle invoice payment events",
          "description": "Listen for the invoice.paid event that indicates successful payment.",
          "events": [
            "invoice.paid"
          ]
        }
      ]
    }
  ]
}

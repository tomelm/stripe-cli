{
  "id": "managed-payments",
  "title": "Set up Managed Payments",
  "description": "Accept global payments for digital products with Stripe as the merchant of record.",
  "type": "learning",
  "products": [
    "Payments"
  ],
  "settings": null,
  "steps": [
    {
      "key": "create-product-chapter",
      "title": "Create a product",
      "description": "Create a digital product with an eligible tax code. View eligibility requirements",
      "required": true,
      "nodes": [
        {
          "type": "apiRequest",
          "key": "create-subscription-product",
          "title": "Create Subscription Product",
          "request": {
            "path": "/v1/products",
            "method": "post",
            "params": {
              "default_price_data": {
                "currency": "usd",
                "recurring": {
                  "interval": "month"
                },
                "unit_amount": 1000
              },
              "description": "A basic subscription to our service",
              "name": "Basic subscription",
              "tax_code": "txcd_10103100"
            }
          }
        },
        {
          "type": "apiRequest",
          "key": "create-one-time-product",
          "title": "Create One Time Product",
          "request": {
            "path": "/v1/products",
            "method": "post",
            "params": {
              "default_price_data": {
                "currency": "usd",
                "unit_amount": 1000
              },
              "description": "A Shakespearean tragedy",
              "name": "Hamlet (e-book)",
              "tax_code": "txcd_10103100"
            }
          }
        }
      ]
    },
    {
      "key": "create-checkout-session-chapter",
      "title": "Create a Checkout Session",
      "required": true,
      "nodes": [
        {
          "type": "apiRequest",
          "key": "create-checkout-session",
          "title": "Create Checkout Session",
          "description": "Set the managed_payments[enabled] parameter to true and use 2026.02-25.preview or above as your version header.",
          "request": {
            "path": "/v1/checkout/sessions",
            "method": "post",
            "params": {
              "line_items": [
                {
                  "price": "${node.create-product-chapter.create-subscription-product:default_price}",
                  "quantity": 1
                }
              ],
              "managed_payments": {
                "enabled": true
              },
              "mode": "subscription",
              "success_url": "https://dashboard.stripe.com/workbench/blueprints/managed-payments/create-checkout-session-chapter?confirmation-redirect=create-checkout-session"
            }
          }
        }
      ]
    },
    {
      "key": "complete-checkout-chapter",
      "title": "Test your checkout",
      "nodes": [
        {
          "type": "uiComponent",
          "key": "complete-checkout",
          "title": "Complete a test payment",
          "description": "Try different billing addresses to see how tax is calculated for customers in different locations. Then, process a test payment using this test card information."
        }
      ]
    },
    {
      "key": "handle-webhooks-chapter",
      "title": "Set up webhooks",
      "description": "Monitor successful payments instantly.",
      "nodes": [
        {
          "type": "asyncHandler",
          "key": "wait-for-checkout-completed",
          "title": "Listen for checkout.session.completed",
          "description": "We’ll send this event every time a customer successfully checks out. API docs",
          "events": [
            "checkout.session.completed"
          ]
        }
      ]
    }
  ]
}
